---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/common/Navbar.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import MoodTrackingSection from '../components/mood/MoodTrackingSection.astro';
import SessionBookingSection from '../components/therapy/SessionBookingSection.astro';
import ResourceLibrarySection from '../components/resources/ResourceLibrarySection.astro';
import CrisisSupportSection from '../components/crisis/CrisisSupportSection.astro';
import Footer from '../components/common/Footer.astro';
---

<BaseLayout
  title="ZenFeed - Chống Ồn Thị Giác Cho Facebook & Sức Khỏe Tinh Thần"
  description="Chrome Extension lọc Facebook bằng AI. Tự động thu gọn drama, cờ bạc lừa đảo và tin giật gân theo đúng tiêu chí của bạn, bảo vệ đôi mắt và sự bình yên trong tâm trí."
>
  <div class="relative overflow-hidden bg-[#EBF0F6] min-h-screen">
    <!-- Header Navigation -->
    <Navbar />

    <!-- Main Content Sections -->
    <main>
      <!-- Hero with Tactile ANC Simulator & Preset Chips -->
      <HeroSection />

      <!-- Digital Wellness & Cognitive Time Calculator -->
      <MoodTrackingSection />

      <!-- 3 Curated Mindful Filter Packs (CBT & Behavioral Science) -->
      <SessionBookingSection />

      <!-- Resource Library & 432Hz Ambient Singing Bowl Player -->
      <ResourceLibrarySection />

      <!-- Crisis Support & 4-4-4-4 Box Breathing Guide with Active Banner Shield -->
      <CrisisSupportSection />
    </main>

    <!-- Footer with FAQ & Objection Crushers -->
    <Footer />
  </div>
</BaseLayout>
