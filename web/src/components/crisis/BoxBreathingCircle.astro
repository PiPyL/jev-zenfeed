---
// BoxBreathingCircle.astro: Tactile Neumorphic 4-4-4-4 Box Breathing Interactive Guide
---

<div class="flex flex-col items-center justify-center p-8 neumorph-inset rounded-3xl relative overflow-hidden bg-[#E4EAF2]">
  <!-- Background Glow Ring -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-64 h-64 rounded-full bg-[#D5E5DC]/40 blur-2xl"></div>
  </div>

  <!-- Breathing Circle Element -->
  <div class="relative w-56 h-56 flex items-center justify-center my-6">
    <!-- Pulsing Outer Ring -->
    <div
      id="breathing-ring"
      class="w-48 h-48 rounded-full neumorph-card flex items-center justify-center transition-transform duration-1000 ease-in-out border-2 border-white/60"
      style="transform: scale(1.12);"
    >
      <!-- Center Soft Inset Core -->
      <div class="w-32 h-32 rounded-full neumorph-inset flex flex-col items-center justify-center text-center p-4">
        <div id="breath-action-text" class="text-sm font-extrabold text-[#436A57] uppercase tracking-wider transition-colors duration-500">
          Hít Vào
        </div>
        <div id="breath-seconds-counter" class="text-3xl font-black text-[#232D3F] mt-1">
          4
        </div>
      </div>
    </div>
  </div>

  <!-- Instruction Subtext -->
  <div class="text-center max-w-sm space-y-2 mt-2">
    <div id="breath-guidance-subtext" class="text-xs font-semibold text-[#526071] min-h-[32px] flex items-center justify-center">
      Hít vào sâu bằng mũi trong 4 giây. Cảm nhận lồng ngực mở rộng.
    </div>
    <div class="text-[11px] text-[#5A6A7D]">
      Chu kỳ thở 4-4-4-4 (Box Breathing) kích hoạt hệ thần kinh phó giao cảm hạ nhịp tim.
    </div>
  </div>
</div>

<script>
  import { soundSynth } from '../../lib/audio/sound-synthesizer';

  const ring = document.getElementById('breathing-ring');
  const actionText = document.getElementById('breath-action-text');
  const secondsCounter = document.getElementById('breath-seconds-counter');
  const guidanceText = document.getElementById('breath-guidance-subtext');

  type Phase = 'inhale' | 'hold-in' | 'exhale' | 'hold-out';

  const phases: { phase: Phase; action: string; guidance: string; scale: number; color: string }[] = [
    {
      phase: 'inhale',
      action: 'Hít Vào',
      guidance: 'Hít vào sâu bằng mũi trong 4 giây. Cảm nhận lồng ngực mở rộng.',
      scale: 1.12,
      color: '#436A57'
    },
    {
      phase: 'hold-in',
      action: 'Giữ Hơi',
      guidance: 'Duy trì trạng thái tĩnh lặng. Không khí tràn ngập oxy thanh sạch.',
      scale: 1.12,
      color: '#416080'
    },
    {
      phase: 'exhale',
      action: 'Thở Ra',
      guidance: 'Thở ra từ từ bằng miệng trong 4 giây. Thả lỏng toàn bộ cơ thể.',
      scale: 0.92,
      color: '#5A6A7D'
    },
    {
      phase: 'hold-out',
      action: 'Nghỉ Ngơi',
      guidance: 'Giữ tâm trí trống rỗng. Buông bỏ hoàn toàn mọi âu lo mạng xã hội.',
      scale: 0.92,
      color: '#436A57'
    }
  ];

  let currentPhaseIndex = 0;
  let currentSecond = 4;

  setInterval(() => {
    currentSecond--;

    if (currentSecond <= 0) {
      currentPhaseIndex = (currentPhaseIndex + 1) % phases.length;
      currentSecond = 4;

      const current = phases[currentPhaseIndex];

      if (ring) {
        ring.style.transform = `scale(${current.scale})`;
      }

      if (actionText) {
        actionText.textContent = current.action;
        actionText.style.color = current.color;
      }

      if (guidanceText) {
        guidanceText.textContent = current.guidance;
      }

      // Soft chime on inhale start
      if (current.phase === 'inhale') {
        soundSynth.playZenChime();
      }
    }

    if (secondsCounter) {
      secondsCounter.textContent = String(currentSecond);
    }
  }, 1000);
</script>
