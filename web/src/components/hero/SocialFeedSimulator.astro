---
// SocialFeedSimulator.astro: Realistic interactive feed with tactile ANC filter & preset chips
---

<div class="w-full neumorph-card-elevated p-5 sm:p-7 relative overflow-hidden bg-[#EBF0F6]">
  <!-- Background Ripple Wave Element -->
  <div id="anc-wave-effect" class="absolute inset-0 bg-[#D5E5DC]/30 pointer-events-none opacity-0 transition-opacity duration-700"></div>

  <!-- Simulator Top Bar -->
  <div class="flex items-center justify-between pb-4 border-b border-[#A6B4C8]/30">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 neumorph-inset-subtle rounded-full flex items-center justify-center text-[#526071]">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
        </svg>
      </div>
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-[#7E8D9F]">Mô Phỏng Trực Tiếp</div>
        <div class="text-sm font-semibold text-[#232D3F]">Facebook News Feed</div>
      </div>
    </div>

    <!-- Visual Noise Gauge -->
    <div class="flex items-center gap-2.5 neumorph-inset-subtle px-3 py-1.5 rounded-xl">
      <div class="w-2.5 h-2.5 rounded-full bg-[#E58C8A] animate-ping" id="noise-pulse-dot"></div>
      <div class="text-xs">
        <span class="text-[#7E8D9F]">Mức độ rác:</span>
        <span id="noise-level-text" class="font-bold text-[#E58C8A] ml-1">88% (Cực cao)</span>
      </div>
    </div>
  </div>

  <!-- Interactive Preset Filter Chips -->
  <div class="pt-3 pb-2 flex items-center gap-2 overflow-x-auto no-scrollbar text-[11px]" id="simulator-preset-chips">
    <span class="text-[#5A6A7D] font-semibold shrink-0">Tiêu chí:</span>
    <button type="button" class="preset-chip px-3 py-1 rounded-full neumorph-pill-active text-[#436A57] font-semibold shrink-0 cursor-pointer">
      Tất Cả Rác Mạng
    </button>
    <button type="button" class="preset-chip px-3 py-1 rounded-full neumorph-pill text-[#526071] font-semibold shrink-0 cursor-pointer">
      Drama & Tin Giật Gân
    </button>
    <button type="button" class="preset-chip px-3 py-1 rounded-full neumorph-pill text-[#526071] font-semibold shrink-0 cursor-pointer">
      Cờ Bạc & Cho Vay Nóng
    </button>
  </div>

  <!-- Feed Posts Container with stable min-height to eliminate CLS -->
  <div class="mt-3 space-y-3.5 min-h-[380px] transition-all">
    <!-- Toxic Post 1: Showbiz Drama Rage-Bait -->
    <div id="post-toxic-1" class="neumorph-card-subtle p-4 pl-5 relative overflow-hidden transition-all duration-500 transform">
      <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#E58C8A] rounded-l-[14px]"></div>
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-[#F9E7E7] text-[#E58C8A] font-bold text-xs flex items-center justify-center">BP</div>
          <div>
            <div class="text-xs font-bold text-[#232D3F]">Góc Bóc Phốt Showbiz 24h</div>
            <div class="text-[11px] text-[#5A6A7D]">Được tài trợ • Gợi ý cho bạn</div>
          </div>
        </div>
        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#F9E7E7] text-[#E58C8A] flex items-center gap-1">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          Drama Gây Hấn
        </span>
      </div>
      <p class="text-sm text-[#232D3F] font-medium leading-snug">
        CHẤN ĐỘNG: Lộ đoạn ghi âm đấu tố ngoại tình của diễn viên nổi tiếng. Dân mạng tràn vào tổng tấn công trang cá nhân!
      </p>
      <div class="mt-2.5 text-[11px] text-[#5A6A7D] flex items-center gap-4">
        <span>3.4K bình luận cãi vã</span>
        <span>1.2K lượt phẫn nộ</span>
      </div>
    </div>

    <!-- Toxic Post 2: Financial Scam / Gambling Ads -->
    <div id="post-toxic-2" class="neumorph-card-subtle p-4 pl-5 relative overflow-hidden transition-all duration-500 transform">
      <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#E58C8A] rounded-l-[14px]"></div>
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-[#F9E7E7] text-[#E58C8A] font-bold text-xs flex items-center justify-center">TC</div>
          <div>
            <div class="text-xs font-bold text-[#232D3F]">Đầu Tư Tài Chính 4.0</div>
            <div class="text-[11px] text-[#5A6A7D]">Được tài trợ • Quảng cáo liên tục</div>
          </div>
        </div>
        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#F9E7E7] text-[#E58C8A]">
          Quảng Cáo Độc Hại
        </span>
      </div>
      <p class="text-sm text-[#232D3F] font-medium leading-snug">
        Kiếm 50 triệu/ngày không cần làm việc, chỉ cần quét mã nhóm kín Telegram nhận lệnh kéo tài xỉu hoàn vốn ngay!
      </p>
    </div>

    <!-- ANC Active Calm Replacement Card (Collapsed Banner with Unhide option) -->
    <div id="anc-calm-banner" class="hidden neumorph-card-subtle p-4 pl-5 relative overflow-hidden bg-[#D5E5DC]/25 transition-all duration-500 animate-soft-float">
      <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#7FA894] rounded-l-[14px]"></div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-[#D5E5DC] text-[#436A57] flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold text-[#436A57]">🛡️ Đã thu gọn 2 bài viết độc hại (Độ tin cậy 92%)</div>
            <div class="text-[11px] text-[#526071] mt-0.5">Không làm nhảy khung hình. Không gian thị giác của bạn đã tĩnh lặng.</div>
          </div>
        </div>
        <!-- Unhide Proof Button -->
        <button
          id="btn-peek-post"
          type="button"
          class="neumorph-btn px-3 py-1.5 text-[11px] text-[#526071] hover:text-[#232D3F] shrink-0 cursor-pointer"
        >
          Xem lại nội dung
        </button>
      </div>
    </div>

    <!-- Organic Zen Post (Always stays intact) -->
    <div class="neumorph-card-subtle p-4 pl-5 relative overflow-hidden">
      <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-[#7FA894] rounded-l-[14px]"></div>
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-full bg-[#D5E5DC] text-[#436A57] font-bold text-xs flex items-center justify-center">TH</div>
          <div>
            <div class="text-xs font-bold text-[#232D3F]">Thư Viện Tri Thức & Chánh Niệm</div>
            <div class="text-[11px] text-[#5A6A7D]">Bạn bè tương tác thực tế</div>
          </div>
        </div>
        <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-[#D5E5DC] text-[#436A57]">
          Nội Dung Giá Trị
        </span>
      </div>
      <p class="text-sm text-[#526071] leading-relaxed">
        Thói quen dành 15 phút buổi sáng không chạm vào điện thoại giúp giảm 40% chỉ số căng thẳng trong ngày. Hãy giữ cho tâm trí khoảng lặng trước khi tiếp nhận thông tin từ thế giới bên ngoài.
      </p>
    </div>
  </div>
</div>

<script>
  import { soundSynth } from '../../lib/audio/sound-synthesizer';

  const toxic1 = document.getElementById('post-toxic-1');
  const toxic2 = document.getElementById('post-toxic-2');
  const calmBanner = document.getElementById('anc-calm-banner');
  const noiseText = document.getElementById('noise-level-text');
  const noiseDot = document.getElementById('noise-pulse-dot');
  const waveEffect = document.getElementById('anc-wave-effect');
  const peekBtn = document.getElementById('btn-peek-post');

  let isFilterActive = false;

  window.addEventListener('zenfeed:anc-toggle', ((e: CustomEvent<{ active: boolean }>) => {
    isFilterActive = e.detail.active;

    if (isFilterActive) {
      if (waveEffect) {
        waveEffect.classList.remove('opacity-0');
        waveEffect.classList.add('opacity-100');
        setTimeout(() => waveEffect.classList.remove('opacity-100'), 600);
      }

      if (toxic1) {
        toxic1.style.opacity = '0';
        toxic1.style.transform = 'scale(0.96) translateY(-10px)';
        setTimeout(() => toxic1.classList.add('hidden'), 350);
      }
      if (toxic2) {
        toxic2.style.opacity = '0';
        toxic2.style.transform = 'scale(0.96) translateY(-10px)';
        setTimeout(() => toxic2.classList.add('hidden'), 350);
      }

      if (calmBanner) {
        setTimeout(() => {
          calmBanner.classList.remove('hidden');
          calmBanner.style.opacity = '0';
          calmBanner.style.transform = 'scale(0.98)';
          requestAnimationFrame(() => {
            calmBanner.style.opacity = '1';
            calmBanner.style.transform = 'scale(1)';
          });
        }, 360);
      }

      if (noiseText) {
        noiseText.textContent = '0% (Tĩnh lặng tuyệt đối)';
        noiseText.classList.remove('text-[#E58C8A]');
        noiseText.classList.add('text-[#436A57]');
      }
      if (noiseDot) {
        noiseDot.classList.remove('bg-[#E58C8A]', 'animate-ping');
        noiseDot.classList.add('bg-[#7FA894]');
      }
    } else {
      if (calmBanner) {
        calmBanner.classList.add('hidden');
      }
      if (toxic1) {
        toxic1.classList.remove('hidden');
        requestAnimationFrame(() => {
          toxic1.style.opacity = '1';
          toxic1.style.transform = 'scale(1) translateY(0)';
        });
      }
      if (toxic2) {
        toxic2.classList.remove('hidden');
        requestAnimationFrame(() => {
          toxic2.style.opacity = '1';
          toxic2.style.transform = 'scale(1) translateY(0)';
        });
      }

      if (noiseText) {
        noiseText.textContent = '88% (Cực cao)';
        noiseText.classList.add('text-[#E58C8A]');
        noiseText.classList.remove('text-[#436A57]');
      }
      if (noiseDot) {
        noiseDot.classList.add('bg-[#E58C8A]', 'animate-ping');
        noiseDot.classList.remove('bg-[#7FA894]');
      }
    }
  }) as EventListener);

  // Peek button proof interaction
  peekBtn?.addEventListener('click', () => {
    soundSynth.playTactileClick();
    if (toxic1) {
      toxic1.classList.remove('hidden');
      toxic1.style.opacity = '0.7';
      toxic1.style.transform = 'scale(0.98)';
    }
  });

  // Preset chips toggle
  const presetChips = document.querySelectorAll('.preset-chip');
  presetChips.forEach(chip => {
    chip.addEventListener('click', () => {
      presetChips.forEach(c => {
        c.classList.remove('neumorph-pill-active', 'text-[#436A57]');
        c.classList.add('neumorph-pill', 'text-[#526071]');
      });
      chip.classList.add('neumorph-pill-active', 'text-[#436A57]');
      chip.classList.remove('neumorph-pill', 'text-[#526071]');
      soundSynth.playTactileClick();
    });
  });
</script>
