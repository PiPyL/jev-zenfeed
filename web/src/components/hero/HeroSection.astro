---
import AncSwitch from './AncSwitch.astro';
import SocialFeedSimulator from './SocialFeedSimulator.astro';
---

<section id="simulator" class="relative pt-12 pb-20 lg:pt-20 lg:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-14 items-center">
      <!-- Left Content Column -->
      <div class="lg:col-span-6 space-y-7">
        <!-- Eyebrow Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full neumorph-card-subtle bg-[#EBF0F6]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#7FA894] animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-[#436A57]">Chrome Extension Chống Ồn Thị Giác Đầu Tiên Cho Facebook</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#232D3F] leading-[1.14]">
          Thanh lọc mạng xã hội. <br class="hidden sm:inline" />
          <span class="text-[#7FA894]">Trả lại bình yên</span> cho đôi mắt & tâm trí.
        </h1>

        <!-- Subtext: Concise, benefits-driven, no em-dash -->
        <p class="text-lg text-[#526071] leading-relaxed max-w-xl">
          Tự động phát hiện và thu gọn bài viết drama bóc phốt, cờ bạc lừa đảo và tin giật gân trên Facebook theo đúng tiêu chí của bạn. Phản hồi sub-200ms, cài đặt trong 1 click.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a
            href="https://chromewebstore.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="neumorph-btn-sage px-8 py-4 text-base font-semibold flex items-center justify-center gap-3 group text-center"
          >
            <svg class="w-5 h-5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 8v8"></path>
              <path d="M8 12h8"></path>
            </svg>
            <span>Thêm Vào Chrome (Miễn Phí)</span>
          </a>

          <a
            href="#curated-presets"
            class="neumorph-btn px-7 py-4 text-base font-semibold text-[#526071] hover:text-[#232D3F] flex items-center justify-center gap-2 text-center"
          >
            <span>Xem Các Bộ Lọc Mẫu</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Trust Badges (Factual & Conversion-optimized) -->
        <div class="pt-6 grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-[#A6B4C8]/25">
          <div class="neumorph-inset-subtle p-3 text-center">
            <div class="text-base font-bold text-[#436A57]">100% BYOK</div>
            <div class="text-[11px] text-[#5A6A7D] mt-0.5">Không qua máy chủ trung gian</div>
          </div>
          <div class="neumorph-inset-subtle p-3 text-center">
            <div class="text-base font-bold text-[#436A57]">&lt; 200ms</div>
            <div class="text-[11px] text-[#5A6A7D] mt-0.5">Lọc tức thì, 0ms từ cache</div>
          </div>
          <div class="neumorph-inset-subtle p-3 text-center">
            <div class="text-base font-bold text-[#436A57]">An Toàn Nick</div>
            <div class="text-[11px] text-[#5A6A7D] mt-0.5">Không vi phạm chính sách Meta</div>
          </div>
        </div>
      </div>

      <!-- Right Simulator Column -->
      <div class="lg:col-span-6 space-y-4">
        <!-- Floating Switch Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-2">
          <div class="text-xs font-semibold uppercase tracking-wider text-[#5A6A7D] flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-[#7FA894] animate-pulse"></span>
            Trải nghiệm công tắc lọc trực tiếp
          </div>
          <AncSwitch />
        </div>

        <!-- Social Feed Simulator Box -->
        <SocialFeedSimulator />
      </div>
    </div>
  </div>
</section>
