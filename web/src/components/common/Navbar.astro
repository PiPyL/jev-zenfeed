---
import SoundToggle from './SoundToggle.astro';
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[#EBF0F6]/85 border-b border-[#A6B4C8]/20 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none">
      <div class="w-11 h-11 neumorph-card-subtle flex items-center justify-center p-2 group-hover:scale-105 transition-transform">
        <svg class="w-7 h-7" viewBox="0 0 40 40" fill="none">
          <path d="M20 6 C20 6 12 16 12 24 C12 28.4 15.6 32 20 32 C24.4 32 28 28.4 28 24 C28 16 20 6 20 6 Z" fill="#7FA894"/>
          <circle cx="20" cy="24" r="3" fill="#FFFFFF"/>
        </svg>
      </div>
      <div>
        <span class="text-xl font-bold tracking-tight text-[#232D3F]">ZenFeed</span>
        <span class="hidden sm:inline-block ml-2 text-xs font-medium px-2 py-0.5 rounded-full bg-[#D5E5DC] text-[#436A57]">Digital Wellness</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden lg:flex items-center gap-1 neumorph-inset-subtle p-1.5 px-3">
      <a href="#simulator" class="px-3.5 py-1.5 text-sm font-medium text-[#526071] hover:text-[#232D3F] rounded-lg transition-colors">Lọc Tin ANC</a>
      <a href="#mood-tracking" class="px-3.5 py-1.5 text-sm font-medium text-[#526071] hover:text-[#232D3F] rounded-lg transition-colors">Lợi Ích Sức Khỏe</a>
      <a href="#curated-presets" class="px-3.5 py-1.5 text-sm font-medium text-[#526071] hover:text-[#232D3F] rounded-lg transition-colors">Bộ Lọc Tâm Trí</a>
      <a href="#resource-library" class="px-3.5 py-1.5 text-sm font-medium text-[#526071] hover:text-[#232D3F] rounded-lg transition-colors">Thư Viện</a>
      <a href="#crisis-support" class="px-3.5 py-1.5 text-sm font-medium text-[#E58C8A] hover:text-[#D15C5A] rounded-lg transition-colors flex items-center gap-1">
        <span class="w-2 h-2 rounded-full bg-[#E58C8A] animate-pulse"></span>
        Tĩnh Tâm Khẩn Cấp
      </a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Open Source GitHub Link -->
      <a
        href="https://github.com"
        target="_blank"
        rel="noopener noreferrer"
        class="neumorph-circle w-9 h-9 sm:w-10 sm:h-10 text-[#5A6A7D] hover:text-[#232D3F] transition-colors"
        title="Mã nguồn mở trên GitHub"
        aria-label="Xem mã nguồn trên GitHub"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>

      <!-- Procedural Sound Toggle -->
      <SoundToggle />

      <!-- Main CTA Button -->
      <a
        href="https://chromewebstore.google.com"
        target="_blank"
        rel="noopener noreferrer"
        class="neumorph-btn-sage px-3.5 sm:px-5 py-2 sm:py-2.5 text-xs sm:text-sm font-semibold flex items-center gap-1.5 sm:gap-2"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 8v8"></path>
          <path d="M8 12h8"></path>
        </svg>
        <span class="hidden xs:inline sm:inline">Cài Đặt Miễn Phí</span>
        <span class="xs:hidden sm:hidden">Cài Đặt</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden neumorph-circle w-9 h-9 text-[#5A6A7D] hover:text-[#232D3F] flex items-center justify-center cursor-pointer focus:outline-none"
        aria-label="Mở danh mục điều hướng di động"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation Menu -->
  <div id="mobile-nav-menu" class="hidden lg:hidden px-4 pb-4 pt-2 border-t border-[#A6B4C8]/20 bg-[#EBF0F6]/95 backdrop-blur-md">
    <div class="neumorph-inset-subtle p-2 space-y-1">
      <a href="#simulator" class="mobile-nav-link block px-3 py-2 text-xs font-semibold text-[#526071] hover:text-[#232D3F] hover:bg-white/40 rounded-lg transition-colors">Lọc Tin ANC</a>
      <a href="#mood-tracking" class="mobile-nav-link block px-3 py-2 text-xs font-semibold text-[#526071] hover:text-[#232D3F] hover:bg-white/40 rounded-lg transition-colors">Lợi Ích Sức Khỏe</a>
      <a href="#curated-presets" class="mobile-nav-link block px-3 py-2 text-xs font-semibold text-[#526071] hover:text-[#232D3F] hover:bg-white/40 rounded-lg transition-colors">Bộ Lọc Tâm Trí</a>
      <a href="#resource-library" class="mobile-nav-link block px-3 py-2 text-xs font-semibold text-[#526071] hover:text-[#232D3F] hover:bg-white/40 rounded-lg transition-colors">Thư Viện</a>
      <a href="#crisis-support" class="mobile-nav-link block px-3 py-2 text-xs font-semibold text-[#E58C8A] hover:text-[#D15C5A] hover:bg-white/40 rounded-lg transition-colors flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-[#E58C8A] animate-pulse"></span>
        Tĩnh Tâm Khẩn Cấp
      </a>
    </div>
  </div>
</header>

<script>
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-nav-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  mobileToggle?.addEventListener('click', () => {
    const isExpanded = mobileToggle.getAttribute('aria-expanded') === 'true';
    mobileToggle.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
  });

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      mobileToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
