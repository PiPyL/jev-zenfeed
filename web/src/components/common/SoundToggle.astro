---
// Sound Toggle Component with Neumorphic Circle Button
---

<button
  id="sound-toggle-btn"
  type="button"
  class="neumorph-circle w-10 h-10 text-[#526071] hover:text-[#232D3F] transition-colors relative group cursor-pointer"
  aria-label="Bật/Tắt âm thanh thư giãn"
  title="Bật/Tắt âm thanh thư giãn"
>
  <svg id="sound-icon-on" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
  </svg>
  <svg id="sound-icon-off" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden text-[#A6B4C8]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
    <line x1="23" y1="9" x2="17" y2="15"></line>
    <line x1="17" y1="9" x2="23" y2="15"></line>
  </svg>
</button>

<script>
  import { soundSynth } from '../../lib/audio/sound-synthesizer';

  const toggleBtn = document.getElementById('sound-toggle-btn');
  const iconOn = document.getElementById('sound-icon-on');
  const iconOff = document.getElementById('sound-icon-off');

  let isMuted = false;

  toggleBtn?.addEventListener('click', () => {
    isMuted = !isMuted;
    soundSynth.setMuted(isMuted);

    if (isMuted) {
      iconOn?.classList.add('hidden');
      iconOff?.classList.remove('hidden');
      toggleBtn.classList.add('neumorph-inset-subtle');
    } else {
      iconOff?.classList.add('hidden');
      iconOn?.classList.remove('hidden');
      toggleBtn.classList.remove('neumorph-inset-subtle');
      soundSynth.playTactileClick();
    }
  });
</script>
